# pnpm configuration for Vercel deployment with pnpm 10
# Allow build scripts for sharp and its platform-specific packages
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=@img/sharp-linux-x64
onlyBuiltDependencies[]=@img/sharp-darwin-arm64
onlyBuiltDependencies[]=@img/sharp-darwin-x64
onlyBuiltDependencies[]=@img/sharp-win32-x64

# Ensure compatibility with pnpm 9 lockfile
package-manager-strict=false
