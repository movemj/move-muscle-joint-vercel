# pnpm configuration for Vercel deployment
# Approve build scripts for native dependencies (pnpm 10+)
onlyBuiltDependencies:
  - sharp
  - "@img/sharp-linux-x64"
  - "@img/sharp-darwin-arm64"
  - "@img/sharp-darwin-x64"
  - "@img/sharp-win32-x64"

# Ensure compatibility with lockfile version
package-manager-strict=false
